{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly domain-grouped updates, two ordinary PRs per repository, separate majors, and review before every merge.",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/Chicago",
  "dependencyDashboard": false,
  "addLabels": [
    "dependencies",
    "agent-review"
  ],
  "prHeader": "Review required: check dependency impact and CI before merging. Routine domain groups and separate major upgrades share two PR slots per repository; queued updates wait for a slot and the next Monday run.",
  "reviewers": [
    "Coldaine"
  ],
  "reviewersFromCodeOwners": true,
  "assignees": [
    "Coldaine"
  ],
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 0,
  "prCreation": "immediate",
  "internalChecksFilter": "strict",
  "schedule": [
    "* * * * 1"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 1"
    ]
  },
  "updateNotScheduled": false,
  "rebaseWhen": "conflicted",
  "automerge": false,
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Group routine minor, patch, digest, and pin updates; later rules split operational domains.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "application dependencies"
    },
    {
      "description": "Refresh npm ranges even when the newest eligible version already satisfies the old range.",
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group routine development dependencies separately from application runtime dependencies.",
      "matchDepTypes": [
        "devDependencies",
        "dev-dependencies",
        "build-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "development tools"
    },
    {
      "description": "Group routine container tag, digest, and initial pin updates across Dockerfiles, Compose, and other image consumers.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "container images"
    },
    {
      "description": "Group routine infrastructure updates across Kubernetes, Flux, Helm, Kustomize, and Terraform.",
      "matchCategories": [
        "kubernetes",
        "terraform"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "infrastructure"
    },
    {
      "description": "Group routine CI and development-environment updates, including action digests and the Renovate runner version.",
      "matchManagers": [
        "github-actions",
        "devcontainer",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "ci and development environment"
    },
    {
      "description": "Keep major upgrades separate from routine groups and preserve Renovate's related-package groups; never automerge.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-upgrade"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "addLabels": [
      "security",
      "dependencies",
      "agent-review"
    ],
    "schedule": [],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  }
}
