#!/bin/sh
# Refuse direct pushes to main. Renovate config validation runs in CI (validate.yml) on every PR,
# with the runner's own Renovate release.
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      branch="${remote_ref#refs/heads/}"
      echo "Refusing to push directly to $branch. Push a PR branch instead." >&2
      exit 1
      ;;
  esac
done
